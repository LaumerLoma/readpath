# Settings for `docker compose up`. Copy to .env and fill in.
#
# Any OpenAI-compatible endpoint. The probe needs a model that supports tool calling.
# From inside the containers, a server on your own machine is reachable at host.docker.internal.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=
LLM_API_KEY=

# Optional: give either service its own endpoint or model. Unset values fall back to LLM_* above.
# JIT_LLM_BASE_URL=
# JIT_LLM_MODEL=
# PROBE_LLM_BASE_URL=
# PROBE_LLM_MODEL=

# Reasoning models can think for minutes before each fabricated answer. If the endpoint supports
# it, "none" turns that off for the JIT server only; the probe keeps reasoning.
# JIT_LLM_REASONING_EFFORT=none

# Extra probe models the web app offers in a dropdown, weakest first, to compare how models of
# different capability handle the JIT server. PROBE_LLM_MODEL (or LLM_MODEL) is always offered.
# PROBE_MODELS=small-model,medium-model

# JIT_REQUEST_TIMEOUT_SECONDS=300
# PROBE_MAX_STEPS=8
